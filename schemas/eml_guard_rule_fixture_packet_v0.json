{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monogate.eml_guard_rule_fixture_packet.v0",
  "title": "EML Guard Rule Fixture Packet v0",
  "type": "object",
  "required": [
    "schemaVersion",
    "packetType",
    "date",
    "fixtureId",
    "expression",
    "metadata",
    "expectedDecision",
    "expectedRuleIds",
    "claimFlags",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": "monogate.eml_guard_rule_fixture_packet.v0" },
    "packetType": { "const": "eml_guard_rule_fixture_packet_v0" },
    "date": { "type": "string" },
    "fixtureId": { "type": "string" },
    "expression": { "type": "string" },
    "expectedDecision": {
      "enum": [
        "allow_proof_shape",
        "recommend_protected_lowering",
        "block_missing_domain_guard",
        "block_unstable_deep_tree",
        "block_claim_until_evidence"
      ]
    },
    "expectedRuleIds": { "type": "array", "items": { "type": "string" } },
    "claimFlags": { "type": "object", "additionalProperties": { "const": false } }
  },
  "additionalProperties": true
}
