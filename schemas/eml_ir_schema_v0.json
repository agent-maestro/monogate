{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monogate.dev/schemas/eml-ir.v0.json",
  "title": "EML IR v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "source_expression",
    "arguments",
    "nodes",
    "output_node",
    "cost_model",
    "tree_superbest_nodes",
    "dag_superbest_nodes",
    "tree_eml_nodes",
    "dag_eml_nodes",
    "lowering",
    "replay_packet",
    "boundaries"
  ],
  "properties": {
    "schema_version": { "const": "eml-ir.v0" },
    "program_id": { "type": "string", "minLength": 1 },
    "source_expression": { "type": "string", "minLength": 1 },
    "arguments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "output_node": { "type": "string", "minLength": 1 },
    "cost_model": { "const": "superbest_v5_3_expression_dag" },
    "tree_superbest_nodes": { "type": "integer", "minimum": 0 },
    "dag_superbest_nodes": { "type": "integer", "minimum": 0 },
    "tree_eml_nodes": { "type": "integer", "minimum": 0 },
    "dag_eml_nodes": { "type": "integer", "minimum": 0 },
    "extra_superbest_savings_nodes": { "type": "integer" },
    "lowering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporary_count", "temporaries", "final_expr", "python_source", "javascript_source"],
      "properties": {
        "temporary_count": { "type": "integer", "minimum": 0 },
        "temporaries": { "type": "array" },
        "final_expr": { "type": "string" },
        "python_source": { "type": "string" },
        "javascript_source": { "type": "string" }
      }
    },
    "replay_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "frame_count", "terminal_state", "frames"],
      "properties": {
        "packet_id": { "type": "string", "minLength": 1 },
        "frame_count": { "type": "integer", "minimum": 1 },
        "terminal_state": { "enum": ["PARKED"] },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/frame" }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internal_only",
        "compiler_behavior_changed",
        "canonical_row_table_changed",
        "public_ready",
        "public_theorem_claim",
        "formal_verification_claim",
        "package_publish_performed",
        "deploy_performed"
      ],
      "properties": {
        "internal_only": { "const": true },
        "compiler_behavior_changed": { "const": false },
        "canonical_row_table_changed": { "const": false },
        "public_ready": { "const": false },
        "public_theorem_claim": { "const": false },
        "formal_verification_claim": { "const": false },
        "package_publish_performed": { "const": false },
        "deploy_performed": { "const": false }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "op", "args", "source", "superbest_cost", "eml_cost", "reuse_count"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["input", "constant", "operation"] },
        "op": { "type": ["string", "null"] },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source": { "type": "string" },
        "superbest_cost": { "type": "integer", "minimum": 0 },
        "eml_cost": { "type": "integer", "minimum": 0 },
        "reuse_count": { "type": "integer", "minimum": 1 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "program_id",
        "runtime_id",
        "kernel_id",
        "lifecycle_state",
        "monotonic_tick",
        "timestamp_ms",
        "input",
        "requested_output",
        "safe_output",
        "guard_action",
        "guard_reason",
        "replay_hash_prev",
        "replay_hash",
        "source",
        "evidence_level"
      ],
      "properties": {
        "frame_id": { "type": "string" },
        "program_id": { "type": "string" },
        "runtime_id": { "const": "eml_ir_pipeline_v0" },
        "kernel_id": { "type": "string" },
        "lifecycle_state": {
          "enum": ["INIT", "READY", "RUNNING", "GUARDED", "END", "PARKED", "FAULTED", "DIVERGED", "REPLAYABLE"]
        },
        "monotonic_tick": { "type": "integer", "minimum": 0 },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "input": {},
        "requested_output": {},
        "safe_output": {},
        "guard_action": { "type": "string" },
        "guard_reason": { "type": "string" },
        "replay_hash_prev": { "type": ["string", "null"] },
        "replay_hash": { "type": "string" },
        "source": { "const": "eml_ir_substrate_v0" },
        "evidence_level": { "const": "simulated" }
      }
    }
  }
}
