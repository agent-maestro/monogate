{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monogate Electronics Artifact Inbox Gate v0",
  "type": "object",
  "required": [
    "schemaVersion",
    "gateType",
    "artifactId",
    "status",
    "inboxStatus",
    "artifactPath",
    "validationRows",
    "summary",
    "claimFlags",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": "monogate.electronics_artifact_inbox_gate.v0" },
    "gateType": { "const": "electronics_artifact_inbox_gate_v0" },
    "artifactId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "inboxStatus": {
      "enum": [
        "pending_no_artifact",
        "artifact_validated",
        "artifact_blocked"
      ]
    },
    "artifactPath": { "type": ["string", "null"] },
    "validationRows": {
      "type": "array",
      "items": { "type": "object" }
    },
    "summary": { "type": "object" },
    "claimFlags": {
      "type": "object",
      "additionalProperties": { "const": false }
    },
    "nonClaims": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
