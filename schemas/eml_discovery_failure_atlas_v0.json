{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monogate EML Discovery Failure Atlas v0",
  "type": "object",
  "required": [
    "schemaVersion",
    "atlasType",
    "artifactId",
    "status",
    "sourceQueue",
    "failurePackets",
    "summary",
    "claimFlags",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": "monogate.eml_discovery_failure_atlas.v0" },
    "atlasType": { "const": "eml_discovery_failure_atlas_v0" },
    "artifactId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "sourceQueue": { "type": "string", "minLength": 1 },
    "failurePackets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "summary": { "type": "object" },
    "claimFlags": {
      "type": "object",
      "additionalProperties": { "const": false }
    },
    "nonClaims": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
