{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "monogate-automation-intervention-ledger.v1",
  "description": "One file per session. Append-only: entries and findings only ever grow. See PROTOCOL.md E1 for what each kind and class MEANS -- the definitions are the measurement, not documentation of it.",
  "type": "object",
  "required": ["session_id", "date", "arm", "entries", "findings"],
  "additionalProperties": false,
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "arm": { "enum": ["baseline", "E2-ai", "E2-human"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ts", "kind", "description"],
        "additionalProperties": false,
        "properties": {
          "ts": { "type": "string" },
          "kind": { "enum": ["direction", "correction", "taste", "mechanical"] },
          "description": { "type": "string", "minLength": 1 },
          "artifact_link": { "type": "string" },
          "boundary": {
            "type": "boolean",
            "description": "The `?` flag. TRUE means the kind was a judgement call. Boundary cases are LOGGED AND FLAGGED, never dropped -- a dropped boundary case is a silent thumb on the scale."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "class", "artifact_link"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "class": { "enum": ["closure", "surprise", "falsification", "dead_end"] },
          "artifact_link": {
            "type": "string",
            "minLength": 1,
            "description": "REQUIRED. House rule 6: no claim without an artifact. A finding with nowhere to point is not yet a finding."
          }
        }
      }
    }
  }
}
