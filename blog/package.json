{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "audit": "node scripts/audit-citations.mjs",
    "predeploy": "npm run audit && npm run check:lean-claims && npm run check:proofs-page && npm run check:axiom-bridge && npm run build && npm run check:exhibit && npm run check:figure",
    "check:lean-claims": "python3 ../../monogate-lean/tools/lean_claims/check_claims.py --self-test --project ../../monogate-lean && python3 ../../monogate-lean/tools/lean_claims/check_claims.py --registry scripts/lean_claims.json --root .",
    "check:proofs-page": "python3 scripts/check_proofs_page.py --self-test && python3 scripts/check_proofs_page.py",
    "check:axiom-bridge": "python3 ../../monogate-lean/tools/axiom_witness/check_bridge.py --self-test",
    "check:exhibit": "node scripts/check-exhibit-gates.mjs",
    "check:figure": "node scripts/check-figure-derives.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.0",
    "astro": "^6.1.8"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
