---
import Base from '../layouts/Base.astro';
import theoremsData from '../data/theorems.json';

// ─── Presentation config only. No facts live here — see src/data/theorems.json ───
const TIER_META: Record<string, { color: string; desc: string }> = {
  THEOREM:     { color: 'var(--green)', desc: 'Complete, checkable proof. No gaps.' },
  PROPOSITION: { color: 'var(--cyan)', desc: 'Proved, short or routine.' },
  CONJECTURE:  { color: 'var(--orange)', desc: 'Precisely stated, believed true, unproved.' },
  OBSERVATION: { color: 'var(--orange)', desc: 'Empirical pattern. No proof.' },
  DEFINITION:  { color: 'var(--violet)', desc: 'A new concept or classification choice.' },
  SPECULATION: { color: '#6b7280', desc: 'Interesting but not currently testable or provable.' },
};

type Result = {
  id: string;
  name: string;
  tier: string;
  session: string;
  category: string;
  statement: string;
  evidence: string;
  verify?: string;
  deps?: string;
  resolvedBy?: string;
  lean?: { file: string; theorem: string; status: 'verified' | 'partial' };
};

const results = theoremsData.results as Result[];

const TIER_ORDER = ['THEOREM', 'PROPOSITION', 'CONJECTURE', 'OBSERVATION', 'DEFINITION', 'SPECULATION'];

const byTier: Record<string, Result[]> = {};
for (const t of TIER_ORDER) byTier[t] = results.filter(r => r.tier === t);

const openConjectures = byTier['CONJECTURE'].filter(r => !r.resolvedBy);
const resolvedConjectures = byTier['CONJECTURE'].filter(r => !!r.resolvedBy);

const theoremCount = byTier['THEOREM'].length;
const propCount = byTier['PROPOSITION'].length;
const conjCount = openConjectures.length;
const obsCount = byTier['OBSERVATION'].length;

// ─── Referential integrity, checked at build time, not just by a separate script ───
// Every `deps`/`resolvedBy` id should resolve to a real entry in this catalog. This
// catches the T19/T22/T41-T43 class of dangling citation the 2026-07-22 audit found
// by hand — see scripts/audit-citations.mjs for the full cross-repo check (Lean
// file/theorem existence); this is the free, in-page half of that check.
//
// EXTERNAL_DEP_ALLOWLIST: tokens that are legitimate but intentionally NOT a
// /theorems entry (references into the older, pre-catalog numbered-round research
// process, e.g. LaTeX section refs). Each must have a one-line reason — this is a
// deliberate, minimal exception list, not a way to silence the check generally
// (mirrors AxiomLedger.lean's legacyAxiomCallSiteAllowlist pattern in machlib).
const EXTERNAL_DEP_ALLOWLIST: Record<string, string> = {
  'R16-C1': 'Pre-catalog research-round reference (recip 1-node correction); not a /theorems entry.',
};
const knownIds = new Set(results.map(r => r.id));
const brokenDeps: string[] = [];
for (const r of results) {
  const refs = [r.deps, r.resolvedBy].filter(Boolean).join(',');
  for (const raw of refs.split(',')) {
    // "T01 (partial)." / "T24." / "T09" -> "T01" / "T24" / "T09": take the
    // leading id-shaped token, ignore trailing punctuation/parentheticals.
    const match = raw.trim().match(/^[A-Za-z0-9_-]+/);
    const id = match ? match[0] : '';
    if (id && !knownIds.has(id) && !(id in EXTERNAL_DEP_ALLOWLIST)) brokenDeps.push(`${r.id} -> ${id}`);
  }
}
if (brokenDeps.length > 0) {
  throw new Error(`theorems.json: dangling id reference(s): ${brokenDeps.join('; ')}`);
}
---

<Base title="Theorem Catalog — monogate.org" description="Honest classification of monogate results. Every result labeled for what it actually is: theorem, proposition, conjecture, or observation.">

  <h1>Theorem Catalog</h1>
  <div class="status-banner">
    <p class="status-kicker">Current status · July 2026</p>
    <p>
      This catalog mixes external theorems, local Lean witnesses,
      propositions, conjectures, and observations. A theorem label means the
      listed statement has the evidence described on its card; it does not
      imply full EML language semantics, compiler correctness, production
      safety, hardware validation, or broad EML superiority.
    </p>
    <p style="margin-top: 10px;">
      A <strong style="color: var(--green);">LEAN&nbsp;✓</strong> badge on a card means that
      statement is <strong>machine-checked in Lean</strong> (0 sorries); cards without it are
      proved on paper. The strongest form of that standard — machine-checked <em>and</em>
      reproducible, with the actual <code>#print axioms</code> footprint re-derived, stamped, and
      exposed — is the live
      <a href="https://zoo.monogateforge.com/" style="color: var(--green);">verified zoo</a>,
      where every green check links to the artifact behind it.
    </p>
    <p style="margin-top: 10px; font-size: 11px; opacity: 0.8;">
      This page is rendered directly from <code>src/data/theorems.json</code> at build time —
      there is no separate copy of these facts to drift out of sync. To add or correct a result,
      edit that file; the page updates automatically on the next build.
    </p>
  </div>
  <p style="color: var(--muted); margin-bottom: 6px;">
    Every result is labeled for what it actually is. Proved facts are theorems. Everything else is clearly marked.
  </p>
  <p style="color: var(--muted); font-size: 0.85rem; margin-bottom: 20px;">
    <span style="color: var(--green); font-weight: 700;">{theoremCount} theorems</span> ·
    <span style="color: var(--cyan); font-weight: 700;">{propCount} propositions</span> ·
    <span style="color: var(--orange); font-weight: 700;">{conjCount} open conjectures</span> ·
    <span style="color: var(--orange); font-weight: 700;">{obsCount} observations</span>
  </p>

  <!-- tier legend -->
  <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px;">
    {TIER_ORDER.map(t => (
      <span style={`font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: ${TIER_META[t].color}; background: ${TIER_META[t].color}15; border: 1px solid ${TIER_META[t].color}30; border-radius: 3px; padding: 3px 8px;`}>
        {t} — {TIER_META[t].desc}
      </span>
    ))}
  </div>

  <!-- filter buttons -->
  <div id="filter-btns" style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 28px;">
    <button data-filter="all" class="filter-btn active" style="font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); background: #9ca3af15; border: 1px solid #9ca3af30; border-radius: 3px; padding: 4px 10px; cursor: pointer;">
      all <span style="opacity:0.5">{results.length}</span>
    </button>
    {TIER_ORDER.map(t => (
      <button
        data-filter={t}
        class="filter-btn"
        style={`font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: ${TIER_META[t].color}; background: ${TIER_META[t].color}15; border: 1px solid ${TIER_META[t].color}30; border-radius: 3px; padding: 4px 10px; cursor: pointer;`}
      >
        {t} <span style="opacity:0.5">{byTier[t].length}</span>
      </button>
    ))}
  </div>

  <!-- result cards -->
  <div id="results-list">
    {TIER_ORDER.map(tier => {
      const items = tier === 'CONJECTURE' ? [...openConjectures, ...resolvedConjectures] : byTier[tier];
      const color = TIER_META[tier].color;
      return (
        <section data-tier={tier} class="tier-section" style="margin-bottom: 32px;">
          <div style={`font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: ${color}; border-bottom: 1px solid ${color}20; padding-bottom: 6px; margin-bottom: 10px;`}>
            {tier} — {byTier[tier].length} · {TIER_META[tier].desc}
          </div>
          {items.map(r => {
            const isResolved = !!r.resolvedBy;
            const tc = TIER_META[r.tier].color;
            return (
              <div
                id={r.id}
                data-tier={r.tier}
                class="result-card"
                style={`background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px 18px; margin-bottom: 10px; opacity: ${isResolved ? '0.55' : '1'}; scroll-margin-top: 90px;`}
              >
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 6px;">
                  <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <span style="font-family: monospace; font-size: 10px; color: var(--muted);">{r.id}</span>
                    <span style={`font-size: 13px; font-weight: 700; color: var(--text); ${isResolved ? 'text-decoration: line-through;' : ''}`}>{r.name}</span>
                    {isResolved && (
                      <span style="font-size: 9px; color: var(--green); background: #15803d15; border: 1px solid #15803d30; border-radius: 3px; padding: 2px 6px;">
                        RESOLVED → {r.resolvedBy}
                      </span>
                    )}
                    {r.lean && (
                      <span title={`${r.lean.file} / ${r.lean.theorem}`} style={`font-size: 9px; font-weight: 700; letter-spacing: 0.08em; padding: 2px 6px; border-radius: 3px; color: ${r.lean.status === 'verified' ? 'var(--green)' : 'var(--orange)'}; background: ${r.lean.status === 'verified' ? '#15803d18' : '#b4530918'}; border: 1px solid ${r.lean.status === 'verified' ? '#15803d50' : '#b4530950'};`}>
                        {r.lean.status === 'verified' ? 'LEAN ✓' : 'LEAN ~'}
                      </span>
                    )}
                  </div>
                  <span style={`font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: ${tc}; background: ${tc}15; border: 1px solid ${tc}30; border-radius: 3px; padding: 2px 6px; white-space: nowrap; flex-shrink: 0;`}>{r.tier}</span>
                </div>
                <div style="font-size: 9px; color: var(--muted); margin-bottom: 7px;">{r.session} · {r.category}</div>
                <div style="font-size: 11px; color: var(--muted); line-height: 1.75; margin-bottom: 7px;">{r.statement}</div>
                <div style="border-top: 1px solid var(--border); padding-top: 7px; font-size: 10px; color: var(--muted); line-height: 1.7;">
                  <span style="font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted);">
                    {r.tier === 'THEOREM' || r.tier === 'PROPOSITION' ? 'Proof: ' :
                     r.tier === 'CONJECTURE' ? 'Evidence: ' :
                     r.tier === 'OBSERVATION' ? 'Data: ' : 'Note: '}
                  </span>
                  {r.evidence}
                </div>
                {r.verify && (
                  <div style="margin-top: 6px; padding: 5px 10px; background: #12151f; border-radius: 4px; font-family: monospace; font-size: 10px; color: var(--cyan); overflow-x: auto; white-space: pre;">{r.verify}</div>
                )}
                {r.deps && (
                  <div style="margin-top: 5px; font-size: 10px; color: var(--muted);">Depends on: {r.deps}</div>
                )}
              </div>
            );
          })}
        </section>
      );
    })}
  </div>

  <div style="margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 11px; color: var(--muted);">
    <a href="/">← monogate.org</a> ·
    <a href="/atlas">Atlas →</a> ·
    <a href="/blog">Blog →</a> ·
    <a href="https://arxiv.org/abs/2603.21852" style="color: var(--cyan);">arXiv:2603.21852</a> ·
    <a href="https://github.com/agent-maestro/monogate-lean" target="_blank" rel="noopener" style="color: var(--green);">Machine-verified proofs (Lean 4) →</a>
  </div>

</Base>

<style>
  .status-banner {
    background: rgba(196,167,125,0.08);
    border: 1px solid rgba(196,167,125,0.24);
    border-radius: 8px;
    padding: 14px 16px;
    margin: 14px 0 22px;
  }
  .status-banner p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }
  .status-banner .status-kicker {
    color: var(--orange);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .filter-btn { transition: all 0.15s; }
  .filter-btn:hover { opacity: 0.8; }
  .filter-btn.active { box-shadow: 0 0 0 1px currentColor; }
  .tier-section.hidden { display: none !important; }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const sections = document.querySelectorAll<HTMLElement>('.tier-section');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      sections.forEach(sec => {
        if (f === 'all' || sec.dataset.tier === f) {
          sec.classList.remove('hidden');
        } else {
          sec.classList.add('hidden');
        }
      });
    });
  });
</script>
