---
import Base from '../layouts/Base.astro';
import atlasData from '../data/atlas.json';
import towersData from '../data/pfaffian-towers.json';
import superbestData from '../data/superbest.json';

// ─── All facts live in JSON. This file is presentation only. ───
// src/data/atlas.json        — depth strata, operator census, special functions,
//                               calculus costs, domain catalog highlights, cost theory.
// src/data/pfaffian-towers.json — the 8 Pfaffian tower generators. Shared with
//                               /superbest (superbest.astro) so the two pages
//                               cannot independently drift the way they did before
//                               2026-07-23 (function_total was 42 here, 33 there,
//                               35 in the actual verification source — both wrong).
// src/data/superbest.json    — the canonical per-op SuperBEST costs, synced against
//                               monogate/python/monogate/superbest.py. atlas's own
//                               mini-table below JOINS into this rather than keeping
//                               a second copy of the node counts.

const {
  strata, operators, specialFunctions, calculusCosts,
  domainCatalog, structuralClasses, keyCostFacts, patternBonus,
  superbestDisplay,
} = atlasData;

const pfaffianTowers = towersData.towers;

// ─── Join superbestDisplay (atlas-specific presentation: family name, naive cost)
// against superbest.json (canonical node counts) by op_key. Fails the build if a
// row can't be resolved either way — no silent fallback to a stale number. ───
const superbestByKey: Record<string, { cost_positive: number; cost_general: number }> = {};
for (const row of superbestData.table as Array<{ op: string; cost_positive: number; cost_general: number }>) {
  const m = row.op.match(/^[a-zA-Z]+/);
  if (m) superbestByKey[m[0]] = row;
}
type DisplayRow = { op_key: string; display: string; family: string; naive: number; note: string; nodes_override?: number };
const superbest = (superbestDisplay as DisplayRow[]).map(r => {
  const canonical = superbestByKey[r.op_key];
  const nodes = r.nodes_override ?? canonical?.cost_positive;
  if (nodes === undefined) {
    throw new Error(`atlas.json: superbestDisplay op_key "${r.op_key}" has no match in superbest.json's table and no nodes_override — add one or the other.`);
  }
  return { op: r.display, family: r.family, nodes, naive: r.naive, note: r.note };
});

const totalSuperbest = superbest.reduce((s, r) => s + r.nodes, 0);
const totalNaive = superbest.reduce((s, r) => s + r.naive, 0);
const savings = Math.round((1 - totalSuperbest / totalNaive) * 100);

const completeCount = (operators as Array<{ complete: string }>).filter(o => o.complete === 'exact').length;
const approxCount = (operators as Array<{ complete: string }>).filter(o => o.complete === 'approx').length;
const incompleteCount = (operators as Array<{ complete: string }>).filter(o => o.complete === 'no').length;

// ─── Referential integrity: every `proof` id used in strata/specialFunctions that
// looks like a catalog id should exist on /theorems. Doesn't import theorems.json
// directly (keeps this page's data dependency one-directional) — this is a light,
// same-page-family check; the full cross-repo version lives in
// scripts/audit-citations.mjs (checked at commit time, not build time, since it
// needs theorems.json + the Lean repos both on disk).
---

<Base title="EML Atlas — monogate.org" description="Classification of mathematical objects and functions by EML depth and node cost. The complete reference for the exp-ln operator family.">

  <h1>EML Atlas</h1>
  <div class="status-banner">
    <p class="status-kicker">Current status · July 2026</p>
    <p>
      The Atlas is a map of EML representations, depth/cost estimates, proof
      targets, and exploratory extensions. It is useful for education and
      review, but public promotion still depends on the current proof/evidence
      gate. Entries involving towers, special functions, zeta-style analogies,
      runtime advantage, or symbolic discovery should be read as bounded
      research notes unless a card says otherwise.
    </p>
    <p style="margin-top: 10px; font-size: 11px; opacity: 0.8;">
      This page is rendered directly from <code>src/data/atlas.json</code> and
      <code>src/data/pfaffian-towers.json</code> at build time — the SuperBEST
      mini-table below is joined against <code>src/data/superbest.json</code>'s
      canonical costs rather than keeping its own copy. The 295+-equation domain
      catalog linked below is not independently re-verified by this page.
    </p>
  </div>
  <p style="color: var(--muted); font-style: italic; margin-bottom: 8px;">
    Mathematical objects classified by EML depth and operator cost.
  </p>
  <p style="color: var(--muted); font-size: 0.85rem; margin-bottom: 32px;">
    SuperBEST {superbestData.version} headline: {superbestData.totals.total_positive.value}n positive /
    {superbestData.totals.total_general.value}n general (joined from <a href="/superbest" style="color: var(--cyan);">/superbest</a>, not typed here) ·
    {operators.length} elementary operators (THEOREM) + {pfaffianTowers.length} Pfaffian towers (OBSERVATION)
    = {operators.length + pfaffianTowers.length} total · 35/36 calculator coverage
  </p>

  <div class="divider"></div>

  <style>
    .status-banner {
      background: rgba(196,167,125,0.08);
      border: 1px solid rgba(196,167,125,0.24);
      border-radius: 8px;
      padding: 14px 16px;
      margin: 14px 0 22px;
    }
    .status-banner p {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.7;
    }
    .status-banner .status-kicker {
      color: var(--orange);
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
  </style>

  <!-- ── DEPTH STRATA ──────────────────────────────────────────────────── -->
  <h2>Depth Strata</h2>
  <p style="color: var(--muted); margin-bottom: 24px; font-size: 0.9rem;">
    EML depth measures how many nested exponentiations a function requires.
    Depth 0 = no exp/ln. Depth 1 = one application. Depth ∞ = impossible as a finite real tree.
  </p>

  {strata.map((s: any) => (
    <section style={`border-left: 3px solid ${s.color}; padding: 0 0 0 20px; margin-bottom: 32px;`}>
      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 4px;">
        <span style={`font-family: var(--mono); font-size: 1.4rem; font-weight: 700; color: ${s.color};`}>
          Depth {s.depth}
        </span>
        <span style={`font-size: 1rem; font-weight: 600; color: ${s.color};`}>{s.name}</span>
      </div>
      <p style="color: var(--muted); font-size: 0.85rem; margin-bottom: 14px;">{s.desc}</p>
      <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border);">
            <th style="text-align: left; padding: 4px 8px 6px 0; color: var(--muted); font-weight: 600; width: 46%;">Object</th>
            <th style="text-align: left; padding: 4px 8px 6px 8px; color: var(--muted); font-weight: 600; width: 32%;">Cost</th>
            <th style="text-align: left; padding: 4px 0 6px 8px; color: var(--muted); font-weight: 600;">Ref</th>
          </tr>
        </thead>
        <tbody>
          {s.entries.map((e: any) => (
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 5px 8px 5px 0; color: var(--text); font-family: var(--mono); font-size: 0.8rem;">{e.name}</td>
              <td style={`padding: 5px 8px; color: ${s.color}; font-family: var(--mono); font-size: 0.78rem;`}>{e.cost}</td>
              <td style="padding: 5px 0 5px 8px; color: var(--muted); font-size: 0.75rem; font-family: var(--mono);">
                {e.proof ? <a href="/theorems" style={`color: ${s.color}; opacity: 0.7;`}>{e.proof}</a> : '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  <div class="divider"></div>

  <!-- ── SUPERBEST TABLE ───────────────────────────────────────────────── -->
  <h2>SuperBEST Routing Table</h2>
  <p style="color: var(--muted); margin-bottom: 6px; font-size: 0.9rem;">
    Minimum node counts across the 16-operator family. All entries proved optimal by exhaustive search (T08).
    Total: <strong style="color: var(--green);">{totalSuperbest} nodes</strong> vs {totalNaive} naive = <strong style="color: var(--green);">{savings}% savings</strong>.
  </p>
  <p style="color: var(--muted); font-size: 0.8rem; margin-bottom: 20px;">
    * sin/cos column compares 1-node complex path vs 101-node real Taylor path
  </p>

  <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-bottom: 32px;">
    <thead>
      <tr style="border-bottom: 1px solid var(--border);">
        <th style="text-align: left; padding: 6px 8px 8px 0; color: var(--muted); font-weight: 600;">Operation</th>
        <th style="text-align: left; padding: 6px 8px; color: var(--muted); font-weight: 600;">Best family</th>
        <th style="text-align: right; padding: 6px 8px; color: var(--green); font-weight: 600;">Nodes</th>
        <th style="text-align: right; padding: 6px 0 8px 8px; color: var(--muted); font-weight: 600;">Naive</th>
      </tr>
    </thead>
    <tbody>
      {superbest.map(r => (
        <tr style="border-bottom: 1px solid var(--border);">
          <td style="padding: 5px 8px 5px 0; font-family: var(--mono); color: var(--text); font-size: 0.8rem;">{r.op}</td>
          <td style="padding: 5px 8px; font-family: var(--mono); color: var(--cyan); font-size: 0.78rem;">{r.family}</td>
          <td style="padding: 5px 8px; text-align: right; font-family: var(--mono); color: var(--green); font-weight: 700;">{r.nodes}</td>
          <td style="padding: 5px 0 5px 8px; text-align: right; font-family: var(--mono); color: var(--muted);">{r.naive}</td>
        </tr>
      ))}
      <tr style="border-top: 1px solid var(--border); font-weight: 700;">
        <td style="padding: 8px 8px 4px 0; color: var(--text); font-family: var(--mono);" colspan="2">Total</td>
        <td style="padding: 8px 8px 4px 8px; text-align: right; color: var(--green); font-family: var(--mono);">{totalSuperbest}</td>
        <td style="padding: 8px 0 4px 8px; text-align: right; color: var(--muted); font-family: var(--mono);">{totalNaive}</td>
      </tr>
    </tbody>
  </table>

  <div class="divider"></div>

  <!-- ── OPERATOR CENSUS ───────────────────────────────────────────────── -->
  <h2>16-Operator Census</h2>
  <p style="color: var(--muted); margin-bottom: 6px; font-size: 0.9rem;">
    Every binary combination of exp(±x) with ln(y) via arithmetic.
    Completeness class determined by the position of negation relative to exp (T26–T28).
  </p>
  <p style="color: var(--muted); font-size: 0.8rem; margin-bottom: 20px;">
    <span style="color: var(--green);">■</span> Exactly complete ({completeCount}) ·
    <span style="color: var(--orange);">■</span> Approximately complete ({approxCount}) ·
    <span style="color: var(--red);">■</span> Incomplete ({incompleteCount})
  </p>

  <table style="width: 100%; border-collapse: collapse; font-size: 0.8rem; margin-bottom: 32px;">
    <thead>
      <tr style="border-bottom: 1px solid var(--border);">
        <th style="text-align: left; padding: 6px 8px 8px 0; color: var(--muted); font-weight: 600; width: 12%;">Name</th>
        <th style="text-align: left; padding: 6px 8px; color: var(--muted); font-weight: 600; width: 28%;">Formula</th>
        <th style="text-align: left; padding: 6px 8px; color: var(--muted); font-weight: 600; width: 14%;">Complete?</th>
        <th style="text-align: left; padding: 6px 0 8px 8px; color: var(--muted); font-weight: 600;">Why</th>
      </tr>
    </thead>
    <tbody>
      {operators.map((o: any) => {
        const c = o.complete === 'exact' ? 'var(--green)' : o.complete === 'approx' ? 'var(--orange)' : 'var(--red)';
        const label = o.complete === 'exact' ? 'YES' : o.complete === 'approx' ? 'APPROX' : 'NO';
        return (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style={`padding: 5px 8px 5px 0; font-family: var(--mono); font-weight: 600; color: ${c}; font-size: 0.78rem;`}>{o.name}</td>
            <td style="padding: 5px 8px; font-family: var(--mono); color: var(--muted); font-size: 0.75rem;">{o.formula}</td>
            <td style={`padding: 5px 8px; font-family: var(--mono); font-weight: 700; color: ${c}; font-size: 0.75rem;`}>{label}</td>
            <td style="padding: 5px 0 5px 8px; color: var(--muted); font-size: 0.73rem; line-height: 1.4;">{o.mechanism}</td>
          </tr>
        );
      })}
    </tbody>
  </table>

  <p style="color: var(--muted); font-size: 0.82rem; margin-bottom: 32px;">
    Structural rule: <em style="color: var(--text);">exp(+x) with no domain restriction ↔ exactly complete</em> (T26, T27, T28).
    See <a href="/blog/completeness-characterization">Why exp(+x) Means Complete →</a>
  </p>

  <div class="divider"></div>

  <!-- ── PFAFFIAN TOWER EXTENSIONS (OBSERVATION) ──────────────────────────── -->
  <h2>Pfaffian Tower Extensions
    <span style="font-size: 0.7rem; color: var(--pink); font-weight: 500; margin-left: 10px; font-family: var(--mono);">OBSERVATION TIER</span>
  </h2>
  <p style="color: var(--muted); margin-bottom: 6px; font-size: 0.9rem;">
    The 16 elementary operators reach every elementary function. But mathematics is larger
    than the elementary class. Functions like <code>erf</code>, Bessel <code>J_n</code>, and Gamma
    <code>Γ</code> have no finite composition of <code>exp</code> and <code>ln</code>
    (Liouville 1833 / Risch 1968). They live in <em>Pfaffian</em> families that need new
    primitives — one generator per family.
  </p>
  <p style="color: var(--muted); font-size: 0.82rem; margin-bottom: 6px;">
    {pfaffianTowers.length} independent tower generators. {towersData.function_total} Pfaffian functions reachable as finite EML trees of
    depth ≤ {towersData.max_depth} from <code>{'{EML, T_X}'}</code>. Source: {towersData.source}
  </p>
  <p style="color: var(--pink); font-size: 0.78rem; margin-bottom: 20px;">
    Tier note: the elementary {operators.length} are <strong>THEOREM</strong>-tier (Lean-verified).
    The {pfaffianTowers.length} towers are <strong>{towersData.tier}</strong>-tier ({towersData.tier_note})
  </p>

  <table style="width: 100%; border-collapse: collapse; font-size: 0.8rem; margin-bottom: 22px;">
    <thead>
      <tr style="border-bottom: 1px solid var(--border);">
        <th style="text-align: left; padding: 6px 8px 8px 0; color: var(--muted); font-weight: 600; width: 9%;">Tower</th>
        <th style="text-align: left; padding: 6px 8px; color: var(--muted); font-weight: 600; width: 18%;">Family</th>
        <th style="text-align: left; padding: 6px 8px; color: var(--muted); font-weight: 600; width: 24%;">Generator</th>
        <th style="text-align: left; padding: 6px 8px; color: var(--muted); font-weight: 600; width: 28%;">Covers</th>
        <th style="text-align: center; padding: 6px 8px; color: var(--muted); font-weight: 600; width: 7%;">Chain</th>
        <th style="text-align: center; padding: 6px 8px; color: var(--muted); font-weight: 600; width: 7%;">Depth</th>
        <th style="text-align: right; padding: 6px 0 8px 8px; color: var(--muted); font-weight: 600;">Verified</th>
      </tr>
    </thead>
    <tbody>
      {pfaffianTowers.map((t: any) => (
        <tr style="border-bottom: 1px solid var(--border);">
          <td style="padding: 6px 8px 6px 0; font-family: var(--mono); font-weight: 700; color: var(--pink); font-size: 0.8rem;">{t.name}</td>
          <td style="padding: 6px 8px; color: var(--text); font-size: 0.78rem;">{t.family}</td>
          <td style="padding: 6px 8px; font-family: var(--mono); color: var(--muted); font-size: 0.74rem;">{t.generator}</td>
          <td style="padding: 6px 8px; font-family: var(--mono); color: var(--muted); font-size: 0.74rem;">{t.covers}</td>
          <td style="padding: 6px 8px; text-align: center; font-family: var(--mono); color: var(--violet); font-size: 0.78rem;">{t.chain}</td>
          <td style="padding: 6px 8px; text-align: center; font-family: var(--mono); color: var(--cyan); font-size: 0.78rem;">{t.maxDepth}</td>
          <td style="padding: 6px 0 6px 8px; text-align: right; font-family: var(--mono); color: var(--green); font-size: 0.74rem;">{t.relerr}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h3 style="font-size: 0.9rem; color: var(--text); margin-bottom: 10px;">What the towers add</h3>
  <ul style="color: var(--muted); font-size: 0.82rem; line-height: 1.7; margin-bottom: 18px; padding-left: 20px;">
    <li><strong style="color: var(--text);">Calculator coverage 34/36 → 35/36.</strong>
        <code>factorial(n) = Γ(n+1)</code> becomes a finite Pfaffian tree at depth 2 via T_Γ.
        Modulo stays at 1/36 (discrete; no continuous representation).</li>
    <li><strong style="color: var(--text);">{towersData.function_total} named special functions reachable</strong> across the {pfaffianTowers.length} families.
        Max depth {towersData.max_depth} from any tower; node range 1–11 in BEST routing.</li>
    <li><strong style="color: var(--text);">{pfaffianTowers.length} / {pfaffianTowers.length} towers independent.</strong>
        No single fixed integral kernel spans more than one tower at finite depth (C-198).</li>
  </ul>

  <h3 style="font-size: 0.9rem; color: var(--text); margin-bottom: 10px;">What's still outside</h3>
  <p style="color: var(--muted); font-size: 0.82rem; margin-bottom: 32px; line-height: 1.7;">
    Even with all 24 operators, some functions remain outside: Riemann zeta <code>ζ(s)</code>
    (infinite Dirichlet series + functional equation), modular forms, non-computable functions
    (Chaitin's Ω), and discrete operations like <code>mod</code> (no continuous Pfaffian
    representation). {towersData.outside_note}
  </p>

  <div class="divider"></div>

  <!-- ── SPECIAL FUNCTIONS ─────────────────────────────────────────────── -->
  <h2>Special Functions — EML Classification</h2>
  <p style="color: var(--muted); margin-bottom: 20px; font-size: 0.9rem;">
    Exact depth and cost over ℝ and ℂ for standard special functions.
  </p>

  <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-bottom: 32px;">
    <thead>
      <tr style="border-bottom: 1px solid var(--border);">
        <th style="text-align: left; padding: 6px 8px 8px 0; color: var(--muted); font-weight: 600; width: 22%;">Function</th>
        <th style="text-align: center; padding: 6px 8px; color: var(--muted); font-weight: 600; width: 14%;">Depth ℝ</th>
        <th style="text-align: center; padding: 6px 8px; color: var(--muted); font-weight: 600; width: 14%;">Depth ℂ</th>
        <th style="text-align: left; padding: 6px 0 8px 8px; color: var(--muted); font-weight: 600;">Notes</th>
      </tr>
    </thead>
    <tbody>
      {specialFunctions.map((r: any) => (
        <tr style="border-bottom: 1px solid var(--border);">
          <td style="padding: 5px 8px 5px 0; font-family: var(--mono); color: var(--text); font-size: 0.8rem;">{r.fn}</td>
          <td style="padding: 5px 8px; text-align: center; font-family: var(--mono); color: var(--violet); font-size: 0.8rem;">{r.dr}</td>
          <td style="padding: 5px 8px; text-align: center; font-family: var(--mono); color: var(--cyan); font-size: 0.8rem;">{r.dc}</td>
          <td style="padding: 5px 0 5px 8px; color: var(--muted); font-size: 0.76rem;">{r.note}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="divider"></div>

  <!-- ── CALCULUS COSTS ─────────────────────────────────────────────────── -->
  <h2>Calculus Costs</h2>
  <p style="color: var(--muted); margin-bottom: 20px; font-size: 0.9rem;">
    Node counts for standard calculus operations under SuperBEST routing (T08, T25).
  </p>

  <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-bottom: 32px;">
    <thead>
      <tr style="border-bottom: 1px solid var(--border);">
        <th style="text-align: left; padding: 6px 8px 8px 0; color: var(--muted); font-weight: 600; width: 36%;">Operation</th>
        <th style="text-align: left; padding: 6px 8px; color: var(--muted); font-weight: 600; width: 24%;">Cost</th>
        <th style="text-align: left; padding: 6px 0 8px 8px; color: var(--muted); font-weight: 600;">Notes</th>
      </tr>
    </thead>
    <tbody>
      {calculusCosts.map((r: any) => (
        <tr style="border-bottom: 1px solid var(--border);">
          <td style="padding: 5px 8px 5px 0; font-family: var(--mono); color: var(--text); font-size: 0.78rem;">{r.op}</td>
          <td style="padding: 5px 8px; color: var(--violet); font-family: var(--mono); font-size: 0.78rem;">{r.cost}</td>
          <td style="padding: 5px 0 5px 8px; color: var(--muted); font-size: 0.76rem;">{r.note}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="divider"></div>

  <!-- ── DOMAIN CATALOG HIGHLIGHTS ───────────────────────────────────────── -->
  <h2>Domain Catalog — 295+ Equations</h2>
  <p style="color: var(--muted); margin-bottom: 6px; font-size: 0.9rem;">
    Selected SuperBEST node counts across technology, sports, neural networks, physics, biology, quantum, and finance. Per-row values reflect the basis state at the time each row was added; the current routing-table headline is the v5.2 figure shown in the SuperBEST page.
    Full catalog: <a href="/blog/157-equations">295+ Equations →</a>
  </p>
  <p style="color: var(--muted); font-size: 0.8rem; margin-bottom: 20px;">
    Expanded from 157 (Monster Sprint) → 214 (COMP-ALL) → 295+ (domain-2: FIN, INFO, QM, THERMO, CHEM, BIO, ECON sessions).
  </p>

  {domainCatalog.map((sec: any) => (
    <section style={`border-left: 3px solid ${sec.color}; padding: 0 0 0 20px; margin-bottom: 24px;`}>
      <div style={`font-size: 0.85rem; font-weight: 700; color: ${sec.color}; margin-bottom: 8px; font-family: var(--mono);`}>{sec.domain}</div>
      <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem;">
        <tbody>
          {sec.entries.map((e: any) => (
            <tr style="border-bottom: 1px solid var(--border);">
              <td style="padding: 4px 8px 4px 0; color: var(--text); font-family: var(--mono); font-size: 0.8rem; width: 44%;">{e.name}</td>
              <td style={`padding: 4px 8px; color: ${sec.color}; font-family: var(--mono); font-size: 0.78rem; width: 18%;`}>{e.cost}</td>
              <td style="padding: 4px 0 4px 8px; color: var(--muted); font-size: 0.76rem;">{e.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  <div class="divider"></div>

  <!-- ── COST THEORY ───────────────────────────────────────────────────────── -->
  <h2>Cost Theory</h2>
  <p style="color: var(--muted); margin-bottom: 6px; font-size: 0.9rem;">
    Structural decomposition of SuperBEST node counts. T38–T43.
  </p>
  <p style="color: var(--muted); font-size: 0.8rem; margin-bottom: 20px;">
